<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import java.net.URL?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.user.RegisterController">
    <stylesheets>
        <URL value="@../styles.css" />
    </stylesheets>

    <AnchorPane prefWidth="500" prefHeight="600" style="-fx-background-color: linear-gradient(to bottom, #87CEFA, #FFFFFF);">
        <VBox alignment="CENTER" spacing="10" prefWidth="350" prefHeight="500" layoutX="75" layoutY="50"
              style="-fx-background-color: white; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);">

            <Label text="Créer un compte" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

            <!-- Nom -->
            <TextField fx:id="nomField" promptText="Nom" />
            <Label fx:id="nomError" textFill="red" visible="false"/>

            <!-- Prénom -->
            <TextField fx:id="prenomField" promptText="Prénom" />
            <Label fx:id="prenomError" textFill="red" visible="false"/>

            <!-- Email -->
            <TextField fx:id="emailField" promptText="Email" />
            <Label fx:id="emailError" textFill="red" visible="false"/>

            <!-- Numéro de carte -->
            <TextField fx:id="numCarteField" promptText="Numéro de carte" />
            <Label fx:id="numCarteError" textFill="red" visible="false"/>

            <!-- Adresse -->
            <TextField fx:id="adresseField" promptText="Adresse" />
            <Label fx:id="adresseError" textFill="red" visible="false"/>

            <!-- Mot de passe -->
            <PasswordField fx:id="passwordField" promptText="Mot de passe" />
            <Label fx:id="passwordError" textFill="red" visible="false"/>

            <!-- Confirmer mot de passe -->
            <PasswordField fx:id="confirmPasswordField" promptText="Confirmer mot de passe" />
            <Label fx:id="confirmPasswordError" textFill="red" visible="false"/>

            <!-- Role Selection -->
            <ComboBox fx:id="roleComboBox">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="CLIENT" />
                        <String fx:value="PATIENT" />
                        <String fx:value="MEDECIN" />
                    </FXCollections>
                </items>
            </ComboBox>
            <Label fx:id="roleError" textFill="red" visible="false"/>

            <!-- Register Button -->
            <Button fx:id="registerButton" text="S'inscrire" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 8 15;" />

            <!-- Success or General Error Message -->
            <Label fx:id="successMessage" textFill="green" visible="false"/>
        </VBox>
    </AnchorPane>
</AnchorPane>
