<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1244.0" style="-fx-background-color: #ecf0f1;" styleClass="background" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.dashboards.Dashboard3Controller">

    <!-- Sidebar -->
    <VBox layoutX="0" layoutY="0" prefHeight="700.0" prefWidth="202.0" style="-fx-background-color: #2c3e50; -fx-padding: 10;" styleClass="card" stylesheets="@../styles.css">

        <!-- User Information -->
        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 10; -fx-background-color: #34495e; -fx-border-radius: 12;">
            <Label fx:id="userNameLabel" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="User Name" />
            <Label fx:id="userStatusLabel" style="-fx-font-size: 14px; -fx-text-fill: #2ecc71;" text="Active" />

            <!-- ✅ "Go to Profile" Button -->
            <Button fx:id="profileButton" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 10;" text="👤 View Profile" />
        </VBox>

        <!-- Sidebar Buttons -->
        <Button prefHeight="37.0" prefWidth="218.0" styleClass="sidebar-button" text="📄 User Management" />
        <Button prefHeight="37.0" prefWidth="193.0" styleClass="sidebar-button" text="📑 Reservations" />
        <Button prefHeight="37.0" prefWidth="207.0" styleClass="sidebar-button" text="🚕 Transport Services" />
        <Button prefHeight="44.0" prefWidth="186.0" styleClass="sidebar-button" text="📊 Reports" />
        <Button onAction="#redirectToDashboardmain" styleClass="sidebar-button" text="📊 go back to dash " />
        <Button onAction="#redirectToDashusers" styleClass="sidebar-button" text="📊 go back to users " />

        <!-- Logout Button -->
        <Button fx:id="logoutButton" prefHeight="23.0" prefWidth="177.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 10;" text="🚪 Logout" />

    </VBox>

    <!-- Dashboard Content -->
    <VBox layoutX="220.0" layoutY="16.0" spacing="30">

        <!-- FIRST ROW -->
        <HBox alignment="CENTER" spacing="40">

            <!-- User Role Statistics -->
            <VBox prefHeight="300.0" prefWidth="400.0" spacing="20" style="-fx-padding: 20; -fx-background-color: white; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);" styleClass="card">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="📊 User Role Distribution" />
                <PieChart fx:id="userRolePieChart" prefHeight="250.0" prefWidth="400.0" />
            </VBox>

            <!-- User Activation Statistics -->
            <VBox prefHeight="300.0" prefWidth="400.0" spacing="20" style="-fx-padding: 20; -fx-background-color: white; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);" styleClass="card">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="👥 Active vs Inactive Users" />
                <PieChart fx:id="userActivationPieChart" prefHeight="250.0" prefWidth="400.0" />
            </VBox>

        </HBox>

    </VBox>

</AnchorPane>
