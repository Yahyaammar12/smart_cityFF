<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.HBox?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/20.0.1" fx:controller="controllers.user.LoginController">
    <stylesheets>
        <URL value="@../styles.css" />
    </stylesheets>

    <AnchorPane prefHeight="400" prefWidth="500" style="-fx-background-color: linear-gradient(to bottom, #87CEFA, #FFFFFF);">
        <VBox alignment="CENTER" layoutX="75" layoutY="60" prefHeight="280" prefWidth="350" spacing="15" style="-fx-background-color: white; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);">

            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Login" />

            <TextField fx:id="emailField" promptText="Email" styleClass="input-field" />
            <PasswordField fx:id="passwordField" promptText="Mot de passe" styleClass="input-field" />

            <Button fx:id="loginButton" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 8 15;" styleClass="submit-button" text="Se connecter" />

            <Label fx:id="errorLabel" textFill="red" />

            <HBox alignment="CENTER" spacing="10">
                <Hyperlink fx:id="registerLink" styleClass="link-text" text="Vous n'avez pas de compte ? Inscrivez-vous" />
                <Hyperlink fx:id="forgotPasswordLink" styleClass="link-text" text="Mot de passe oublié ?" />
            </HBox>

        </VBox>
    </AnchorPane>
</AnchorPane>