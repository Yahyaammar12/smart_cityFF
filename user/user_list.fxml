<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to right, #6dd5ed, #2193b0);" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.user.UserListController">

    <!-- Sidebar from the first FXML -->
    <VBox layoutX="0" layoutY="0" prefHeight="690.0" prefWidth="202.0" style="-fx-background-color: #2c3e50; -fx-padding: 10;" styleClass="card" stylesheets="@../styles.css">
        <!-- User Information -->
        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 10; -fx-background-color: #34495e; -fx-border-radius: 12;">
            <Label fx:id="userNameLabel" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="User Name" />
            <Label fx:id="userStatusLabel" style="-fx-font-size: 14px; -fx-text-fill: #2ecc71;" text="Active" />
            <Button fx:id="profileButton" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 10;" text="👤 View Profile" />
        </VBox>
        <!-- Sidebar Buttons -->
        <Button styleClass="sidebar-button" text="📄 User Management" />
        <Button styleClass="sidebar-button" text="📑 Reservations" />
        <Button styleClass="sidebar-button" text="🚕 Transport Services" />
        <Button prefHeight="44.0" prefWidth="186.0" styleClass="sidebar-button" text="📊 Reports" />
        <!-- Logout Button -->
        <Button fx:id="logoutButton" prefHeight="23.0" prefWidth="177.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 10;" text="🚪 Logout" />
    </VBox>

    <!-- Main Content adjusted with layoutX and layoutY -->
    <VBox alignment="CENTER" layoutX="220.0" layoutY="16.0" spacing="20" style="-fx-padding: 20;">
        <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;" text="👥 Liste des Utilisateurs" />
        <!-- Search Bar and Sorting Container -->
        <HBox spacing="10" style="-fx-alignment: center; -fx-padding: 10;">
            <TextField fx:id="searchField" prefHeight="0.0" prefWidth="368.0" promptText="Rechercher un utilisateur..." styleClass="input-field" stylesheets="@../styles.css" />
            <Button fx:id="searchButton" styleClass="search-button" stylesheets="@../styles.css" text="🔍 Rechercher" />
            <ComboBox fx:id="sortComboBox" prefWidth="200" promptText="Trier par..." />
        </HBox>
        <ScrollPane fitToWidth="true" prefHeight="500" prefWidth="775.0" style="-fx-background-color: transparent;" styleClass="card" stylesheets="@../styles.css">
            <VBox fx:id="userContainer" spacing="15" style="-fx-background-color: transparent; -fx-padding: 15;" />
        </ScrollPane>
    </VBox>

</AnchorPane>
