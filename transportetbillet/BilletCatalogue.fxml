<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            style="-fx-background-color: linear-gradient(to right, #6dd5ed, #2193b0);"
            xmlns="http://javafx.com/javafx/20.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.transportetbillet.BilletCatalogueController">

    <!-- ✅ Sidebar (Left-aligned and Full Height) -->
    <AnchorPane fx:id="sidebar" prefWidth="200.0" prefHeight="600.0" style="-fx-background-color: #2C3E50;">
        <fx:include source="/Layouts/UserSidebar.fxml"/>
    </AnchorPane>

    <!-- ✅ Main Content Wrapper -->
    <AnchorPane fx:id="mainContent" prefWidth="600.0" prefHeight="600.0">
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
            <Button fx:id="weatherButton" text="🌦 Voir Météo"
                    style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-border-radius: 8;"
                    onAction="#openWeatherPage"/>

            <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"
                   text="🎟 Catalogue des Billets"/>

            <ScrollPane fitToWidth="true" prefHeight="500" prefWidth="580.0"
                        style="-fx-background-color: transparent;"
                        styleClass="card" stylesheets="@../styles.css">
                <VBox fx:id="billetContainer" spacing="15"
                      style="-fx-background-color: transparent; -fx-padding: 15;"
                      styleClass="card" stylesheets="@../styles.css">
                </VBox>
            </ScrollPane>
        </VBox>
    </AnchorPane>

</AnchorPane>
