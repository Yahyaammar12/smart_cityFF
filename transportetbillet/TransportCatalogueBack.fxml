<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to right, #6dd5ed, #2193b0);" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.transportetbillet.TransportCatalogueBack">

    <!-- ✅ Sidebar (Fixed on the Left) -->
    <AnchorPane fx:id="sidebar" prefWidth="200.0" prefHeight="600.0"
                style="-fx-background-color: #2C3E50;">
        <fx:include source="/Layouts/AdminSidebar.fxml"/>
    </AnchorPane>

    <!-- ✅ Main Content (Smaller & Spaced) -->
    <AnchorPane layoutX="271.0" layoutY="22.0" prefHeight="400.0" prefWidth="640.0" style="-fx-background-radius: 12; -fx-padding: 10;">
   
        <VBox alignment="CENTER" prefHeight="206.0" prefWidth="660.0" spacing="15" style="-fx-padding: 15; -fx-background-radius: 12; -fx-background-color: rgba(255, 255, 255, 0.9);">
   
            <!-- 🚆 Page Title -->
            <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="🚆 Catalogue des Transports" />
   
            <!-- 🔍 Search Section (Smaller Fields) -->
            <HBox spacing="8">
                <TextField fx:id="searchType" prefWidth="100" promptText="Type" />
                <TextField fx:id="searchCompany" prefWidth="120" promptText="Compagnie" />
                <TextField fx:id="searchDepart" prefWidth="100" promptText="Départ" />
                <TextField fx:id="searchDestination" prefWidth="100" promptText="Destination" />
                <TextField fx:id="searchSchedule" prefWidth="80" promptText="Horaire" />
                <Button fx:id="searchButton" onAction="#searchTransports" style="-fx-background-radius: 8;" text="🔎" />
            </HBox>
   
            <!-- 📜 Pagination & Transport List -->
            <Pagination fx:id="pagination" prefHeight="40" prefWidth="550.0" />
   
            <!-- ➕ Buttons at the Bottom (Smaller & Spaced) -->
            <HBox spacing="10">
                <Button fx:id="addTransportButton" onAction="#openAddTransportWindow" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-border-radius: 8; -fx-padding: 6 16;" text="➕ Ajouter" />
                <Button fx:id="exportCsvButton" onAction="#exportToCSV" style="-fx-background-color: #ff9800; -fx-text-fill: white; -fx-border-radius: 8; -fx-padding: 6 16;" text="📤 Export CSV" />
            </HBox>
   
        </VBox>
    </AnchorPane>

</AnchorPane>
