<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.collections.FXCollections?>

<?import javafx.scene.control.Label?>
<AnchorPane prefHeight="500.0" prefWidth="550.0" style="-fx-background-color: linear-gradient(to right, #6dd5ed, #2193b0); -fx-padding: 20;" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.transportetbillet.AddTransportController">
    <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;" text="➕ Ajouter un Transport" />

    <VBox alignment="CENTER" spacing="20" style="-fx-padding: 15;">


        <VBox prefWidth="500" spacing="12" style="-fx-background-color: white; -fx-border-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 4);" styleClass="card" stylesheets="@../styles.css">

            <!-- Form Fields -->
            <ComboBox fx:id="typeField" promptText="Type (BUS, TRAIN, FLIGHT)" />
            <TextField fx:id="horaireField" promptText="Horaire (HH:MM)" />
            <TextField fx:id="tarifField" promptText="Tarif (TND)" />
            <TextField fx:id="placesField" promptText="Places libres" />
            <TextField fx:id="departField" promptText="Départ" />
            <TextField fx:id="destinationField" promptText="Destination" />
            <TextField fx:id="companyField" promptText="Compagnie" />

            <!-- Image Upload Section -->
            <HBox alignment="CENTER" spacing="15">
                <ImageView fx:id="imagePreview" fitHeight="100" fitWidth="100.0" style="-fx-border-radius: 12; -fx-border-color: #ddd; -fx-border-width: 1;" />
                <VBox prefWidth="542.0" spacing="5">
                    <TextField fx:id="imageField" prefWidth="300" promptText="URL de l'image" />
                    <Button fx:id="uploadImageButton" onAction="#uploadImage" style="-fx-background-color: #007BFF; -fx-text-fill: white; -fx-border-radius: 8;" text="📤 Télécharger Image" />
                </VBox>
            </HBox>

            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="saveButton" onAction="#saveTransport" style="-fx-background-color: #2a9d8f; -fx-text-fill: white; -fx-border-radius: 8;" text="✅ Ajouter" />

                <Button onAction="#closeWindow" style="-fx-background-color: #e63946; -fx-text-fill: white; -fx-border-radius: 8;" text="❌ Annuler" />
            </HBox>

        </VBox>

    </VBox>

</AnchorPane>