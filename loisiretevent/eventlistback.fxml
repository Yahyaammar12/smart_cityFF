<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            style="-fx-background-color: linear-gradient(to right, #6dd5ed, #2193b0);"
            xmlns="http://javafx.com/javafx/20.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.eventetloisir.EventListBack">

    <!-- ✅ Sidebar -->
    <AnchorPane fx:id="sidebar" prefWidth="200.0" prefHeight="600.0" style="-fx-background-color: #2C3E50;">
        <fx:include source="/Layouts/UserSidebar.fxml"/>
    </AnchorPane>

    <!-- ✅ Main Content -->
    <AnchorPane fx:id="mainContent" layoutX="200.0" prefWidth="600.0" prefHeight="600.0">
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 15;">

            <!-- 🏷 Title -->
            <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"
                   text="🎉 Liste des Événements" />

            <!-- 📜 Event List -->
            <ScrollPane fitToWidth="true" prefHeight="520" prefWidth="580.0"
                        style="-fx-background-color: transparent;">
                <VBox fx:id="eventContainer" spacing="8"
                      style="-fx-background-color: transparent; -fx-padding: 10;"/>
            </ScrollPane>

        </VBox>
    </AnchorPane>

</AnchorPane>
