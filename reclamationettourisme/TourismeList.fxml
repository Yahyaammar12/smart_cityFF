<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
      style="-fx-background-color: linear-gradient(to right, #6dd5ed, #2193b0); -fx-padding: 15;"
      xmlns="http://javafx.com/javafx/20.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.tourismeEtReclamation.TourismeListController">

    <HBox spacing="20" alignment="CENTER_LEFT">

    <!-- ✅ Sidebar (Left) -->
    <AnchorPane prefWidth="200.0" style="-fx-background-color: #2C3E50;">
        <fx:include source="/Layouts/AdminSidebar.fxml"/>
    </AnchorPane>
    <!-- ✅ Main Content Section -->
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20; -fx-pref-width: 650;">

        <!-- ✅ Search & Sorting Section -->
        <VBox spacing="8" alignment="CENTER">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchNameField" promptText="🔍 Rechercher par nom..."
                           style="-fx-font-size: 14px; -fx-padding: 6; -fx-border-radius: 5; -fx-pref-width: 180px;"/>

                <ComboBox fx:id="searchLocationBox" promptText="📍 Localisation"
                          style="-fx-font-size: 14px; -fx-padding: 6; -fx-border-radius: 5; -fx-pref-width: 160px;"/>

                <ComboBox fx:id="searchStarsBox" promptText="⭐ Nb Étoiles"
                          style="-fx-font-size: 14px; -fx-padding: 6; -fx-border-radius: 5; -fx-pref-width: 140px;"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <ComboBox fx:id="sortStarsBox" promptText="🔽 Trier par étoiles"
                          style="-fx-font-size: 14px; -fx-padding: 6; -fx-border-radius: 5; -fx-pref-width: 160px;"/>

                <Button text="🔍 Rechercher" fx:id="searchButton"
                        style="-fx-background-color: #007BFF; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 15; -fx-border-radius: 5;"/>

                <Button text="🔄 Réinitialiser" fx:id="resetButton"
                        style="-fx-background-color: #FF5733; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 15; -fx-border-radius: 5;"/>
            </HBox>
        </VBox>

        <!-- ✅ Header Section with Add Button -->
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 8;">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;" text="🏨 Liste des Sites Touristiques" />
            <Button fx:id="addTourismeButton"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 15; -fx-border-radius: 5;"
                    text="➕ Ajouter un Site" />
        </HBox>

        <!-- ✅ Scrollable Content (Pagination) -->
        <ScrollPane fitToWidth="true" prefHeight="380" prefWidth="650.0"
                    style="-fx-background-color: transparent;">
            <VBox fx:id="tourismeContainer" spacing="10"
                  style="-fx-background-color: transparent; -fx-padding: 10;">
            </VBox>
        </ScrollPane>

        <!-- ✅ Pagination Controls -->
        <Pagination fx:id="pagination" pageCount="1" maxPageIndicatorCount="5"
                    style="-fx-background-color: transparent;"/>
    </VBox>
    </HBox>

</AnchorPane>
