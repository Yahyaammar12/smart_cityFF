<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="702.0" prefWidth="1077.0" style="-fx-background-color: linear-gradient(to bottom right, #B2FEFA, #0ED2F7);" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.tourismeEtReclamation.TourismeListUserController">

    <!-- ✅ Main Layout with Sidebar & Content -->
    <HBox alignment="CENTER_RIGHT" prefHeight="600.0" prefWidth="900.0" spacing="20">
        <AnchorPane prefWidth="200.0" prefHeight="600.0" style="-fx-background-color: #2C3E50;">
            <fx:include source="/Layouts/UserSidebar.fxml"/>
        </AnchorPane>
        <!-- ✅ Centered VBox in Middle-Right -->
        <VBox layoutX="550.0" layoutY="70.0" prefHeight="600.0" prefWidth="616.0" spacing="15" style="-fx-background-color: white; -fx-background-radius: 12;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3); -fx-padding: 20;">

            <!-- ✅ Top Navigation Bar -->
            <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #0ED2F7; -fx-background-radius: 12; -fx-padding: 10;">
                <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;" text="🏨 Liste des Sites Touristiques" />
            </HBox>

            <!-- ✅ Search & Sorting Section -->
            <VBox alignment="CENTER" spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <TextField fx:id="searchNameField" promptText="🔍 Rechercher par nom..." style="-fx-font-size: 14px; -fx-padding: 6; -fx-border-radius: 5; -fx-pref-width: 180px;" />

                    <ComboBox fx:id="searchLocationBox" promptText="📍 Localisation" style="-fx-font-size: 14px; -fx-padding: 6; -fx-border-radius: 5; -fx-pref-width: 160px;" />

                    <ComboBox fx:id="searchStarsBox" prefHeight="42.0" prefWidth="171.0" promptText="⭐ Nb Étoiles" style="-fx-font-size: 14px; -fx-padding: 6; -fx-border-radius: 5; -fx-pref-width: 140px;" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <ComboBox fx:id="sortStarsBox" promptText="🔽 Trier par étoiles" style="-fx-font-size: 14px; -fx-padding: 6; -fx-border-radius: 5; -fx-pref-width: 160px;" />

                    <Button fx:id="searchButton" style="-fx-background-color: #007BFF; -fx-text-fill: white;                                 -fx-font-size: 14px; -fx-padding: 8 15; -fx-border-radius: 5;" text="🔍 Rechercher" />

                    <Button fx:id="resetButton" style="-fx-background-color: #FF5733; -fx-text-fill: white;                                 -fx-font-size: 14px; -fx-padding: 8 15; -fx-border-radius: 5;" text="🔄 Réinitialiser" />

                    <Button fx:id="weatherButton" onAction="#goToWeatherPage" prefHeight="34.0" prefWidth="137.0" style="-fx-background-color: #ff9800; -fx-text-fill: white;                                 -fx-font-size: 16; -fx-padding: 10;" text="🌤 Voir la météo" />
                </HBox>
            </VBox>

            <!-- ✅ Title / Subtext -->
            <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #333;" text="Nos Sites Touristiques" />
            <Label style="-fx-font-size: 13; -fx-text-fill: #666;" text="Découvrez les sites touristiques disponibles." />

            <!-- ✅ Scrollable Content - Centered in Middle-Right -->
            <ScrollPane fitToWidth="true" prefHeight="380" prefWidth="650.0" style="-fx-background-color: transparent;">
                <VBox fx:id="tourismeContainer" spacing="10" style="-fx-background-color: transparent; -fx-padding: 10;" />
            </ScrollPane>

            <!-- ✅ Pagination Controls -->
            <Pagination fx:id="pagination" maxPageIndicatorCount="5" pageCount="1" style="-fx-background-color: transparent;" />

        </VBox>

    </HBox>

</AnchorPane>
