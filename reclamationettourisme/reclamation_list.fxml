<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to right, #6dd5ed, #2193b0); -fx-padding: 15;" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.tourismeEtReclamation.ReclamationListController">

    <HBox alignment="CENTER_LEFT" spacing="20" />
     <!-- ✅ Sidebar (Left) -->
    <AnchorPane prefWidth="200.0" style="-fx-background-color: #2C3E50;">
        <fx:include source="/Layouts/AdminSidebar.fxml"/>
    </AnchorPane>


        <!-- Main Content -->
     <VBox alignment="CENTER" layoutX="390.0" layoutY="80.0" spacing="15" style="-fx-padding: 20; -fx-pref-width: 650;">

            <!-- ✅ Search Filters -->
         <HBox alignment="CENTER_LEFT" spacing="10">
             <TextField fx:id="searchSujetField" prefHeight="42.0" prefWidth="194.0" promptText="🔍 Rechercher par sujet..." style="-fx-font-size: 14px; -fx-padding: 6; -fx-border-radius: 5; -fx-pref-width: 200px;" stylesheets="@../styles.css" />

                <ComboBox fx:id="searchTourismeBox" prefHeight="0.0" prefWidth="206.0" promptText="🏨 Site Touristique" style="-fx-font-size: 14px; -fx-padding: 6; -fx-border-radius: 5; -fx-pref-width: 160px;" stylesheets="@../styles.css" />

                <ComboBox fx:id="searchRatingBox" promptText="⭐ Note" style="-fx-font-size: 14px; -fx-padding: 6; -fx-border-radius: 5; -fx-pref-width: 120px;" stylesheets="@../styles.css" />

                <ComboBox fx:id="searchSolvedBox" promptText="✔ Résolu ?" style="-fx-font-size: 14px; -fx-padding: 6; -fx-border-radius: 5; -fx-pref-width: 120px;" stylesheets="@../styles.css" />
         </HBox>

            <!-- ✅ Search and Reset Buttons -->
         <HBox alignment="CENTER_LEFT" spacing="10">
             <Button fx:id="searchButton" style="-fx-background-color: #007BFF; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 15; -fx-border-radius: 5;" stylesheets="@../styles.css" text="🔍 Rechercher" />
             <Button fx:id="resetButton" style="-fx-background-color: #FF5733; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 15; -fx-border-radius: 5;" stylesheets="@../styles.css" text="🔄 Réinitialiser" />
         </HBox>

            <!-- ✅ Header -->
         <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" text="📜 Liste des Réclamations" />

            <!-- ✅ Scrollable Container for Reclamations -->
         <ScrollPane fitToWidth="true" prefHeight="450" prefWidth="650.0" style="-fx-background-color: transparent;">
             <VBox fx:id="reclamationContainer" spacing="15" style="-fx-background-color: transparent; -fx-padding: 15;">
                </VBox>
         </ScrollPane>

            <!-- ✅ Pagination Controls -->
         <Pagination fx:id="pagination" maxPageIndicatorCount="5" pageCount="1" style="-fx-background-color: transparent;" />

        </VBox>
</AnchorPane>
